# ── Admin sign-in: city Keycloak OIDC (internal realm) ─────────────────────
# /qradmin authenticates against the city SSO. Get a Client ID + Client
# Secret from IT (Keycloak Client Configuration), registering this exact
# redirect URI on the client:
#   https://ggcity-toolbox.web.app/oauth2-callback
# (plus any custom-domain variant of the toolbox you use).
OIDC_ISSUER=https://auth.ggcity.org/realms/internal
OIDC_CLIENT_ID=

# The client secret is NOT kept in .env — it lives in Cloud Secret Manager:
#   firebase functions:secrets:set OIDC_CLIENT_SECRET
# For the local emulator, put  OIDC_CLIENT_SECRET=…  in functions/.secret.local
# (git-ignored) instead.

# Optional comma-separated allow-list of AD usernames (preferred_username)
# admitted to /qradmin. Empty = any signed-in city employee.
OIDC_ADMIN_USERS=

# Neutral public origin for resident-facing QR short-links (/q/) and stats (/s/).
# Empty falls back to the request host. e.g. https://ggc-go.web.app
QR_PUBLIC_BASE=

# Where a scan of an unknown/removed code redirects (retired printed QR fallback).
QR_FALLBACK_URL=https://www.ggcity.org
